# ==============================================================================
# Try4T — Environment Variables Template
# Sao chep thanh apps/api/.env va apps/web/.env.local (KHONG commit file .env!)
# ==============================================================================

# --- APP & NETWORK ---
NODE_ENV=development
API_PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000

# --- DATABASE (Neon PostgreSQL Serverless / PostgreSQL Local) ---
# Neon: copy "Pooled connection" -> DATABASE_URL, "Direct connection" -> DIRECT_URL
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/try4t?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech/try4t?sslmode=require"

# --- AUTHENTICATION (JWT + Refresh Token Rotation) ---
# Nen dung chuoi ngau nhien >= 32 ky tu cho moi secret
JWT_ACCESS_SECRET="try4t-dev-access-secret-change-in-production-min-32-chars"
JWT_REFRESH_SECRET="try4t-dev-refresh-secret-change-in-production-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
COOKIE_DOMAIN=""
COOKIE_SECURE=false

# --- HYBRID CLOUD STORAGE (Phase 1+) ---
# Image: cloudinary | r2
STORAGE_IMAGE_PROVIDER=cloudinary
# Video: r2 (khuyen dung $0 egress) | cloudinary (fallback khi chua bat R2)
STORAGE_VIDEO_PROVIDER=cloudinary

# Cloudinary (Anh bia 16:9, Avatar, Chung tu, Fallback Video)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Cloudflare R2 (Video bai giang & Tai lieu — Direct Presigned Upload)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="try4t-media"
R2_PUBLIC_URL=""

# --- PAYMENT GATEWAY (Phase 3+) ---
PAYMENT_SANDBOX_ENABLED=true
SEPAY_API_KEY=""
SEPAY_WEBHOOK_SECRET=""
VIETQR_BANK_CODE="MB"
VIETQR_ACCOUNT_NO=""
VIETQR_ACCOUNT_NAME="TRY4T EDUCATION"

# --- PLATFORM ECONOMICS ---
PLATFORM_DEFAULT_FEE_RATE=0.30

# --- EMAIL / OTP SERVICE (Gmail SMTP | Resend | Dev Fallback) ---
# MAIL_PROVIDER: smtp | resend | dev
MAIL_PROVIDER=dev
MAIL_FROM="Try4T <no-reply@try4t.dev>"
# Neu dung Gmail SMTP (gui moi email khong can domain): tao App Password tai myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
# Hoac dung Resend API
RESEND_API_KEY=""

# --- OAUTH 2.0 (Google & GitHub Third-Party Sign-In) ---
# Google Console Redirect URI: http://localhost:4000/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# GitHub OAuth App Callback URL: http://localhost:4000/api/v1/auth/oauth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- FRONTEND (apps/web/.env.local) ---
NEXT_PUBLIC_APP_NAME="Try4T"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
