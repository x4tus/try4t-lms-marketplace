    "@types/express": "^5.0.1",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.7",
    "@types/qrcode": "^1.5.6",
    "prisma": "^6.6.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
